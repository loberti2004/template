{
  "name": "tabletop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "preview": "vite preview --host",
    "dev:cf": "wrangler pages dev dist --live-reload",
    "cf:deploy": "wrangler pages deploy dist",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv",
    "db:init": "npx wrangler d1 create tabletop-db --local",
    "db:schema": "npx wrangler d1 execute tabletop-db --local --file=./schema.sql",
    "db:query": "npx wrangler d1 execute tabletop-db --local --command"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251121.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "sass": "^1.77.8",
    "typescript": "^5.8.3",
    "vite": "^8.2.2",
    "wrangler": "4.79.0"
  }
}
